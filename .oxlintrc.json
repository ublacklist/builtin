{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "options": {
    "denyWarnings": true,
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "curly": "error",
    "import/extensions": ["error", "ignorePackages"]
  }
}
