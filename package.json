{
  "name": "@ublacklist/builtin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run /^check:/",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:serpinfo": "node ./scripts/check-serpinfo.ts",
    "fix": "pnpm run /^fix:/",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "update-searxng-instances": "node ./scripts/update-searxng-instances.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@ublacklist/serpinfo": "3.0.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2"
}
